	public function getLoginHistoryExcelFile($startdate, $enddate, $department){
		
		$columnHeader = '';
		
		$loginhostrydata = $this->User_model->getLoginHistoryExcel($startdate, $enddate, $department);		
		
		$columnHeader = "Sr. No." . "\t" . "Department" . "\t" . "Employee Name / Designation" . "\t" . "Pf. No." . "\t". "Total Login" . "\t";  
		$setData = '';  
		
		$rowData = ''; 
		$i=1;
		foreach ($loginhostrydata as $ldata) {  
			$logincount = $this->User_model->getTotalLoginCount($ldata->user_id);
			$userdetail = $this->User_model->getUserDetailByID($ldata->user_id);
			$department = $this->User_model->getDepartmentNamebyID($userdetail[0]->emp_department);
			$designation = $this->User_model->getDesignationNamebyID($userdetail[0]->emp_designation);
			
			$ldata = '"' .$i. '"' . "\t";
			
			$empname = $userdetail[0]->employee_name;
			$department_name = $department[0]->name;
			
			$ldata .= '"' . $department_name . '"' . "\t";
			
			$designation_name = $designation[0]->name;
			$ldata .= '"' . $empname.'/'.$designation_name . '"' . "\t";
			
			$pf_number = $userdetail[0]->employee_code;
			$ldata .= '"' . $pf_number . '"' . "\t";
			
			
			$logincount = $logincount; 			
			$ldata .= '"' . $logincount . '"' . "\t";  
			
			$rowData .= trim($ldata) . "\n";  
			$i++;
		}  //exit;
		$setData .= trim($rowData) . "\n";		  
		  
		header("Content-type: application/octet-stream");  
		header("Content-Disposition: attachment; filename=loginHistoryReport.xls");  
		header("Pragma: no-cache");  
		header("Expires: 0");  
		
		echo ucwords($columnHeader) . "\n" . $setData . "\n";
	}
	
