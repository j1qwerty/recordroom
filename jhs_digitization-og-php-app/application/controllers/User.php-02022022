    public function document_report_filter($seldepartment='') {

        $this->check_logg();
        $config = array();
        $data['Report'] = array();
        $department = $this->User_model->getdepartments();
        $data['departmentlist'] = $department;

        if(!empty($this->input->post()) && $this->input->post('search')=='Search'){
            $data['selecteddep'] = $this->input->post('department');
            
            $seldepartment = $this->input->post('department');
            $config["base_url"] = base_url() . "user/document_report_filter".'/'.$seldepartment;
            $data["total_rows"] = $config["total_rows"] = $this->User_model->getEmployeeCount($seldepartment);
            $config["per_page"] = 10;
            $config["uri_segment"] = 3;

            $this->pagination->initialize($config);
            $data["page"] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
            
            $data["links"] = $this->pagination->create_links();
            
            $data['Report'] = $this->User_model->getEmployeeList($seldepartment, $config["per_page"], $page);
            $data['selecteddepsearch'] = $seldepartment;
        }

        if(!empty($seldepartment)){
            $data['selecteddep'] = $seldepartment;
            
            $seldepartment = $seldepartment;
            $config["base_url"] = base_url() . "user/document_report_filter".'/'.$seldepartment;
            $data["total_rows"] = $config["total_rows"] = $this->User_model->getEmployeeCount($seldepartment);
            $config["per_page"] = 10;
            $config["uri_segment"] = 4;

            $this->pagination->initialize($config);
            $data["page"] = $page = ($this->uri->segment(4)) ? $this->uri->segment(4) : 0;
           
            $data["links"] = $this->pagination->create_links();
            
            $data['Report'] = $this->User_model->getEmployeeList($seldepartment, $config["per_page"], $page);
            $data['selecteddepsearch'] = $seldepartment;
        }
        if($data['selecteddepsearch'] != 'all'){
            $departmentNameGet = $this->User_model->getDepartmentNamebyID($data['selecteddepsearch']);
            $departmentName = $departmentNameGet[0]->name;
        }else{
            $departmentName = 'all';
        }

        // summary starts
        $data['srSummary'] = $this->User_model->getSR_SummarybyDept($departmentName);
        $data['lrSummary'] = $this->User_model->getLR_SummarybyDept($departmentName);
        $data['attachmentSummary'] = $this->User_model->getAttach_SummarybyDept($departmentName);
        $aparSummary = $this->User_model->getApar_SummarybyDept($departmentName);

        // print_r('<pre>');
        $current_year = date("Y");
        $countAparFinal = [];
			for($c=$current_year;$c>$current_year-4;$c--){
        			// $countApar[$c] = 0;
        			$totalCountApar[$c] = 0;
        			$totalPagesApar[$c] = 0;
        	}

        if(!empty($aparSummary)) {
            foreach ($aparSummary as $key => $value) {
	        	if(!empty($value->apar)){
	        		for($c=$current_year;$c>$current_year-4;$c--){
		        			$countApar[$c] = 0;
		        	}
	        		$apar_year_wise = explode(' ', $value->apar);

	        			foreach ($apar_year_wise as $key => $value) {
	        				$explodedYearApar = explode('->', $value);
	        				// print_r('<pre>');
		        			// print_r($explodedYearApar);
		        			if(count($explodedYearApar) > 1){
			        			$countApar[$explodedYearApar[0]] = $explodedYearApar[1];
			        		}
	        			}

	        		// print_r($countApar);
	        		$countAparFinal[] = $countApar; 
	        		// exit;
	        	}
	        }
	    }
	    

        //print_r($countAparFinal);
        $total1 = $total2 = $total3 = $total4 = $total5 = 0;

        $count1 = $count2 = $count3 = $count4 = $count5 = 0;
        $totalApar = $countAparTotal = array(
        	$current_year => 0,
        	$current_year-1 => 0,
        	$current_year-2 => 0,
        	$current_year-3 => 0,
                $current_year-4 => 0
        );
        // print_r($countAparTotal);
        // exit;
        if(!empty($countAparFinal)){
        	$countAparFinal2 = array();
        	foreach ($countAparFinal as $key => $valueFinalArray) {
        		foreach ($valueFinalArray as $key1 => $value) {
        			// if($value != 0){
	        			if($key1 == $current_year){
	        				$value?$count1++:'';
	        				$total1 += $value;
	        				$totalApar[$current_year] = $total1;
	        				$countAparTotal[$current_year] = $count1;
	        			}elseif($key1 == $current_year-1){
	        				$value?$count2++:'';
	        				$total2 += $value;
	        				$totalApar[$current_year-1] = $total2;
	        				$countAparTotal[$current_year-1] = $count2;
	        			}elseif($key1 == $current_year-2){
	        				$value?$count3++:'';
	        				$total3 += $value;
	        				$totalApar[$current_year-2] = $total3;
	        				$countAparTotal[$current_year-2] = $count3;
	        			}elseif($key1 == $current_year-3){
	        				$value?$count4++:'';
	        				$total4 += $value;
	        				$totalApar[$current_year-3] = $total4;
	        				$countAparTotal[$current_year-3] = $count4;
                                        }elseif($key1 == $current_year-4){
	        				$value?$count5++:'';
	        				$total5 += $value;
	        				$totalApar[$current_year-4] = $total5;
	        				$countAparTotal[$current_year-4] = $count5;
	        			}
	        		// }
        		}
        	}
        }

        $data['totalApar'] = $totalApar;
        $data['countAparTotal'] = $countAparTotal;
        // print_r($data['countAparTotal']);
        // exit;
        // summary ends here totalApar

        // count of records
        $data['srCount'] = $this->User_model->getSR_CountbyDept($departmentName);
        $data['lrCount'] = $this->User_model->getLR_CountbyDept($departmentName);
        $data['attachCount'] = $this->User_model->getAt_CountbyDept($departmentName);
        // summary ends here

        

        // print_r($data);
        // exit;
        $this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("document_report", $data);
        $this->load->view("layout/footer"); 

    }

