    public function getfilecopybyid() {

        $id = $this->uri->segment(3);
        $empid = $this->uri->segment(4);
        $query = $this->db->query("select * from upload_file where file_id='$id'");
        $rs = $query->result();
        echo $rs[0]->filename;
    }
    
    /* Upload map data - 10-02-2021 */
    public function upload_map($file_barcode) {
        $this->check_logg();
//        $empid = $this->uri->segment(3);
        if ($file_barcode != '') {
            $data['lr'] = $this->User_model->getMAPdetail($file_barcode);
            $this->load->view("layout/header");
            $this->load->view("layout/leftmenu");
            $this->load->view("upload_map", $data);
            $this->load->view("layout/footer");
        } else {
            redirect("file/file_listing");
        }
    }
    public function uploadmap($file_barcode) { 
		$this->check_logg();
		
        if (!file_exists("uploads/" . $file_barcode)) {
            mkdir("uploads/" . $file_barcode . "/files", 0755);
            mkdir("uploads/" . $file_barcode . "/map", 0755);
        }

        extract($_POST);
        $error = array();
//        $extension = array("jpeg", "jpg", "png", "gif");
        $extension = array("jpeg", "jpg", "png", "gif", "PNG", "JPG", "JPEG","pdf","PDF");
        foreach ($_POST['check'] as $key => $tmp_name) {
            $key2 = $_POST['check'][$key];
            $file_name = $_FILES["sbook"]["name"][$key2];
            $file_tmp = $_FILES["sbook"]["tmp_name"][$key2];
            $ext = pathinfo($file_name, PATHINFO_EXTENSION);
//            $newfile_name = $empcode . "-LR-" . $_POST['pageno'][$key2] . "." . $ext;
            $newfile_name = $file_barcode . "-MAP-" . $_POST['pageno'][$key2] . "." . $ext;
            $image_name = time() . str_replace(" ", "", $newfile_name);
			
            $pagecounter = $this->User_model->checkDuplicateMapNo($_POST['pageno'][$key2], $file_barcode);
			
            if (in_array($ext, $extension)) {
                if ($pagecounter == 0) {
					
                    if (!file_exists("uploads/" . $file_barcode . "/map")) {
                            mkdir("uploads/" . $file_barcode . "/map", 0755);
                    }
					
                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $file_barcode . "/map/" . $newfile_name);
					
                        $pathimage = "uploads/" . $file_barcode . "/map/"; 
                        $filesize = $pathimage.$newfile_name;

                        if($filesize <= 512000){
                                echo '';
                        }elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
                                $this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 60);
                        }elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
                                $this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 50);
                        }elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
                                $this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 35);
                        }elseif($filesize > 4194304){ //4MB above 25%
                                $this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 25);
                        }else{
                                echo '';
                        }
					
                    $pageno = $_POST['pageno'][$key2];
                    $result = $this->User_model->savemap($file_barcode, $newfile_name, $pageno, 1);
                } else {
                    $filename = basename($file_name, $ext);

                    $newfile_name = $file_barcode . "-MAP-" . $_POST['pageno'][$key2] . "-V" . $this->User_model->getPagerVersionMap($file_barcode, $_POST['pageno'][$key2]) . "." . $ext;
                    $image_name = time() . str_replace(" ", "", $newfile_name);

                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $file_barcode . "/map/" . $newfile_name);
					
					$pathimage = "uploads/" . $file_barcode . "/map/"; 
					$filesize = $pathimage.$newfile_name;
										
					if($filesize <= 512000){
						echo '';
					}elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 60);
					}elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 50);
					}elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 35);
					}elseif($filesize > 4194304){ //4MB above 25%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 25);
					}else{
						echo '';
					}
					
                    $pageno = $_POST['pageno'][$key2];
                    $vers = $this->User_model->getPagerVersionMap($file_barcode, $_POST['pageno'][$key2]);
                    $result = $this->User_model->saveempmap($file_barcode, $newfile_name, $pageno, $vers);
                }
                // $this->User_model->incrementCounter('lr',$empid);
            } else {
                $this->session->set_flashdata("error", "This extension not uploaded.");
//                $this->session->set_flashdata('item', array('message' => 'This extension not uploaded', 'class' => 'error'));
                redirect("user/upload_map/" . $file_barcode);
            }
        }

        if ($result > 0) {
//            $this->session->set_flashdata('item', array('message' => 'Map added successfully', 'class' => 'success'));
            $this->session->set_flashdata("error", "Map added successfully.");
            redirect("user/upload_map/" . $file_barcode);
        } else {
//            $this->session->set_flashdata('item', array('message' => 'Map update successfully', 'class' => 'success'));
            $this->session->set_flashdata("error", "Map update successfully.");
            redirect("user/upload_map/" . $file_barcode);
        }
    }
    public function deletemap($id,$file_barcode) {
		
		$this->check_logg();

        $this->check_logg();
        if ($id != '') {
            $this->User_model->deletemap($id);

//            $lrcount = $this->User_model->getEmployeeMAPcountExcel($empid);

//            $this->User_model->incrementDecrementCounter('map', $empid, $lrcount);

            // $this->User_model->decrementCounter('lr',$empid);
            $this->session->set_flashdata('item', array('message' => 'Map deleted successfully.', 'class' => 'success'));
            redirect("user/upload_map/" . $file_barcode);
