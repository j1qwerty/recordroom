    public function insert_data(){
        $employee_document = $this->User_model->employee_document();
        if(!empty($employee_document)) {

            $empID = $employee_document->employee_id;
            // print_r($empID);
            // exit;

            $srcount = $this->User_model->getEmployeeSRcountExcel($empID);
            $lrcount = $this->User_model->getEmployeeLRcountExcel($empID);
            $attachmentcount = $this->User_model->getEmployeeAttachmentcountExcel($empID);
            $aparcount = $this->User_model->getEmployeeAparcountexcel($empID);
            $acount = '';
            if(!empty($aparcount)){
                foreach($aparcount as $countapar){
                    $acount.= $countapar->startdate.'->'.$countapar->totalcount.' ';
                }
            }else{
                $acount = '0';
            }

            $result = $this->User_model->update_employee_records($empID, $srcount, $lrcount, $attachmentcount, $acount);

        }



        print_r($employee_document?$employee_document->employee_id:"Done");
        header("Refresh:0");
       

    }
	
	function CountOfUserScript($start){
		echo "<pre>";
		if($start!=''){
			$GetAllUser = $this->User_model->GetAllUserByLimit($start);
			foreach($GetAllUser as $user){
				
				$UploadAllActiveByStartGR = '';
				$UserSrCount = count($this->User_model->GetUserSrByEmpID($user->emp_id));
				$UserLrCount = count($this->User_model->GetUserLrByEmpID($user->emp_id));
				$TotalYr = $this->User_model->GetUploadAllActive();
				foreach ($TotalYr as $row) {
					$UploadAllActiveByStartGRCOunt = count($this->User_model->GetUploadByEmpIdAllActive($row->startdate,$user->emp_id));
					$UploadAllActiveByStartGR .= $row->startdate.'->'.$UploadAllActiveByStartGRCOunt.' ';
				}
				$AttachmentCount = count($this->User_model->GetAttAllActiveGroupByIdEmp($user->emp_id));
				
				$existsData =  count($this->User_model->CheckDataExits($user->emp_id));
				
				
				if($existsData > 0){
					$arrDate = array(
						'sr'  			=>	$UserSrCount,
						'lr'  			=>	$UserLrCount,
						'attachment'  	=>	$AttachmentCount,
						'apar'  		=>	$UploadAllActiveByStartGR,
					);
					$result = $this->User_model->UpdateEmpDocment($user->emp_id,$arrDate);
				}else{
					$arrDate = array(
						'sr'  					=>		$UserSrCount,
						'lr'  					=>		$UserLrCount,
						'attachment'  			=>		$AttachmentCount,
						'apar'  				=>		$UploadAllActiveByStartGR,
						'employee_code'  		=>		$user->employee_code,
						'emp_name'  			=>		$user->employee_name,
						'department'  			=>		$user->emp_department,
						'designation'  			=>		$user->emp_designation,
						'isupdated'  			=>		1,
						'employee_id'  			=>		$user->emp_id,
					);
					$result = $this->User_model->InsertEmpDocment($arrDate);
				}
				
				echo '</br>';
				print_r($user->emp_id);
	
			}
		}
		echo "<pre>";
		
		exit;
		
		
		
	}
    
    /* UPLOAD FILE - 08-02-2021 */
        
    public function uploadfile($file_barcode) {
	$this->check_logg();
        if ($file_barcode != '') {
            $data['sb'] = $this->User_model->getFiledetail($file_barcode);
            $this->load->view("layout/header");
            $this->load->view("layout/leftmenu");
            $this->load->view("uploadfile", $data);
            $this->load->view("layout/footer");
        } else {
            redirect("file/file_listing");
        }
    }
    
    public function deletefile($file_id,$file_barcode) {
	$this->check_logg();

        $this->check_logg();
        if ($file_id != '') {
            $this->User_model->deleteFileCopy($file_id);

            $this->session->set_flashdata("success", "File copy deleted successfully.");
            redirect("user/uploadfile/" . $file_barcode);
        } else {
            $this->session->set_flashdata("error", "File copy not deleted.");
            redirect("user/uploadfile/" . $file_barcode);
        }
    }
    
    public function uploadFileCopy($file_barcode) {
        $this->check_logg();
		//FILE upload
        if (!file_exists("uploads/" . $file_barcode)) {
            mkdir("uploads/" . $file_barcode, 0755);
            mkdir("uploads/" . $file_barcode . "/files", 0755);
        }

        array_multisort($_FILES['sbook']['size'], SORT_DESC, SORT_STRING, $_FILES['sbook']['name'], SORT_STRING);
        extract($_POST);
        $error = array();
//        $extension = array("jpeg", "jpg", "png", "gif", "PNG", "JPG", "JPEG");

        $extension = array("jpeg", "jpg", "png", "gif", "PNG", "JPG", "JPEG","pdf","PDF","xlsx","XLSX");
        foreach ($_POST['check'] as $key => $tmp_name) {
            $key2 = $_POST['check'][$key];

            $file_name = $_FILES["sbook"]["name"][$key2];

            $file_tmp = $_FILES["sbook"]["tmp_name"][$key2];

            $ext = pathinfo($file_name, PATHINFO_EXTENSION);
            $newfile_name = $file_barcode . "-FILE-" . $_POST['pageno'][$key2] . "." . $ext;
            
            $pagecounter = $this->User_model->checkDuplicateFilePageNo($_POST['pageno'][$key2], $file_barcode);            
            
            if (in_array($ext, $extension)) {
                if ($pagecounter == 0) {
					
                    if (!file_exists("uploads/" . $file_barcode . "/files")) {
                            mkdir("uploads/" . $file_barcode . "/files", 0755);
                    }
					
                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $file_barcode . "/files/" . $newfile_name);
				

                    //Compress image script
                    /*$pathimage = "uploads/" . $file_barcode . "/files/"; 
                    $filesize = $pathimage.$newfile_name;


                    $info = getimagesize($filesize);
                    echo $info['mime'];exit;
                    
                    if ($info['mime'] == 'image/jpeg'){ 
                        $image = imagecreatefromjpeg($filesize);
