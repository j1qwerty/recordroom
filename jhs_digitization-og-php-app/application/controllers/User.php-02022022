    public function load_all_employee_ajax() {
        $data = $this->User_model->employeelist();
        $arr = array();
        $arr['data'] = array();
        if (!empty($data)):
            $i = 1;
            foreach ($data as $emp):
                switch ($emp->gender) {
                    case 'M':
                        $gender = 'Male';
                        break;
                    case 'F':
                        $gender = 'Female';
                        break;
                    default:
                        $gender = $emp->gender;
                        break;
                }
                $arr['data'][] = array(
                    $i,
                    $emp->employee_code,
                    $emp->employee_name,
                    $gender,
                    $emp->mobile,
                    '<a class="btn btn-primary btn-sm" href="' . base_url() . 'user/viewFileCopy/' . $emp->emp_id . '"><span class="glyphicon glyphicon-eye-open"></span> FILE (' . count($this->User_model->getFiledetail($emp->emp_id)) . ')</a>
                    <a class="btn btn-primary btn-sm" href="' . base_url() . 'user/viewMapData/' . $emp->emp_id . '"><span class="glyphicon glyphicon-eye-open"></span> MAP (' . count($this->User_model->getMAPdetail($emp->emp_id)) . ')</a>
                    <a class="btn btn-primary btn-sm" href="' . base_url() . 'user/view_report_log/' . $emp->emp_id . '"><span class="glyphicon glyphicon-eye-open"></span> Report Log </a>
                    <a class="btn btn-success btn-sm" href="' . base_url() . 'user/uploadfile/' . $emp->emp_id . '"><span class="glyphicon glyphicon-cloud-upload"></span> FILE</a>
                    <a class="btn btn-success btn-sm" href="' . base_url() . 'user/upload_map/' . $emp->emp_id . '"><span class="glyphicon glyphicon-cloud-upload"></span> MAP</a>'
                );
                $i++;
            endforeach;
        endif;
        $json = json_encode($arr);
        echo $json;
    }

