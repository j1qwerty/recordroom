    public function getEmployeeExcelFile($departmentid){

    	$current_year = date("Y");

        if($departmentid != 'all'){
            $department = $this->User_model->getDepartmentNamebyID($departmentid);
        }else{
            $department = 'all';
        }
        $columnHeader = '';
        
        $employeeData = $this->User_model->getEmployeeExcelFromTemp($department);      

        $columnHeader = "Sr. No." . "\t" . "Pf. No.". "\t" . "Employee Name" . "\t" . "Department" . "\t" . "Designation" . "\t". "SR" . "\t"."LR"  ;
       /*  for($i=$current_year;$i>$current_year-5;$i--){
			$columnHeader.= "\t". "APAR->".$i;
    	} */
		
		/* ================= */
		$columnHeader.= "\t"."APAR->2020";
		$TotalYr = $this->User_model->GetUploadAllActive();
		foreach ($TotalYr as $row) { 
			//$columnHeader.= '\t'.'APAR->'.$row->startdate;
			$columnHeader.= "\t"."APAR->".$row->startdate;
		}
		/* ================= */

        $columnHeader.= "\t"."Attachment"."\t";  

        $setData = '';  
        $rowData = ''; 
        $i=1;

        foreach ($employeeData as $reportEmployee1) {  
       		$year = [];
       		for($c=$current_year;$c>$current_year-5;$c--){
        			$year[$c] = 0;
        	}
        	$aparData = $reportEmployee1->apar;
        	if(!empty($aparData)){
        		$apar_year_wise = explode(' ', $aparData);
        		if(!empty($apar_year_wise)) {
        			foreach ($apar_year_wise as $key => $value) {
        				# code...
        				$explodedYearApar = explode('->', $value);
        				// print_r('<pre>');
	        			// print_r($explodedYearApar);
	        			if(count($explodedYearApar) > 1){
		        			$year[$explodedYearApar[0]] = $explodedYearApar[1];
		        		}
        			}
        		}
        	}
        	// print_r($year);
        	// exit;
            $reportEmployee = '"' .$i. '"' . "\t";
            
            $reportEmployee .= '"' . $reportEmployee1->employee_code . '"' . "\t";

            $reportEmployee .= '"' . $reportEmployee1->emp_name . '"' . "\t";

            $reportEmployee .= '"' . $reportEmployee1->department . '"' . "\t";

            $reportEmployee .= '"' . $reportEmployee1->designation . '"' . "\t";

            $reportEmployee .= '"' . $reportEmployee1->sr . '"' . "\t";

            $reportEmployee .= '"' . $reportEmployee1->lr . '"' . "\t";
            foreach ($year as $key => $valueApar) {
            	# code...
            	// print_r($valueApar);
	            $reportEmployee .= '"' . $valueApar . '"' . "\t";
            }
            	// exit;

            $reportEmployee .= '"' . $reportEmployee1->attachment . '"' . "\t";

            $rowData .= trim($reportEmployee) . "\n";  
            $i++;
        }  //exit;
        $setData .= trim($rowData) . "\n";        
          
        header("Content-type: application/octet-stream");  
        header("Content-Disposition: attachment; filename=document_report.xls");  
        header("Pragma: no-cache");  
        header("Expires: 0");  
        
        echo ucwords($columnHeader) . "\n" . $setData . "\n";
    }
