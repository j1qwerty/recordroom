    public function search_employee($search_result='') {

        $this->check_logg();
        $this->load->view("layout/header");
        $this->load->view("layout/leftmenu");

        if (isset($_POST['search'])) {
            $this->form_validation->set_rules('search', 'Employee/Emp. Code', 'min_length[3]');
            if ($this->form_validation->run() != FALSE) {
                $search = $this->input->post('search');

                if ($search == '') {
                    $this->session->set_userdata('blank', 'Search');
                    redirect('user/employee_listing');
                }

                $config["base_url"] = base_url() . "user/search_employee/".$search;
		        $data["total_rows"] = $config["total_rows"] = $this->User_model->search_employee_count($search);
		        $config["per_page"] = 10	;
		        $config["uri_segment"] = 3;
		        
                $this->pagination->initialize($config);
                $data["page"] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
		
		        $data["links"] = $this->pagination->create_links();		
				
				$this->pagination->initialize($config);
				
				$data['employees'] = $this->User_model->search_employee_data($search, $config["per_page"], $page);

                $data['search'] = array('search' => $search);

                $this->load->view("search_employee", $data);
            } else {
                $this->check_logg();
                $data['search'] = array('search' => '');
                $this->load->view("search_employee", $data);
            }
        } elseif (!empty($this->uri->segment('4'))) {

        	$config["base_url"] = base_url() . "user/search_employee/".$search_result;
	        $data["total_rows"] = $config["total_rows"] = $this->User_model->search_employee_count(urldecode($search_result));
	        $config["per_page"] = 10	;
	        $config["uri_segment"] = 4;

	        $this->pagination->initialize($config);

            $data["page"] = $page = ($this->uri->segment(4)) ? $this->uri->segment(4) : 0;

	        $data["links"] = $this->pagination->create_links();		
			
			$this->pagination->initialize($config);
			
			$data['employees'] = $this->User_model->search_employee_data(urldecode($search_result), $config["per_page"], $page);

            $data['search'] = array('search' => urldecode($search_result));

            $this->load->view("search_employee", $data);
        } else {
        	$search_result = $this->uri->segment('3');
            // $this->load->view("search_employee");
            if ($search_result == '') {
                $this->session->set_userdata('blank', 'Search');
                redirect('user/employee_listing');
            }
            $config["base_url"] = base_url() . "user/search_employee/".$search_result;
	        $data["total_rows"] = $config["total_rows"] = $this->User_model->search_employee_count($search_result);
	        $config["per_page"] = 10	;
	        $config["uri_segment"] = 4;

	        $this->pagination->initialize($config);
            $data["page"] = $page = ($this->uri->segment(4)) ? $this->uri->segment(4) : 0;
	
	        $data["links"] = $this->pagination->create_links();		
			
			$this->pagination->initialize($config);
			
			$data['employees'] = $this->User_model->search_employee_data($search_result, $config["per_page"], $page);

            $data['search'] = array('search' => $search_result);

            $this->load->view("search_employee", $data);
        }
        $this->load->view("layout/footer");
    }

