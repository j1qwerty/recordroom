    public function getOtpExcelFile($mobile='',$pfnumber='') {

        $columnHeader = '';
        
        $otpData = $this->User_model->getOtpNotSubmittedExcel($mobile, $pfnumber);  
  
        $columnHeader = "Sr. No." . "\t" . "Pf. No." . "\t" . "Employee Name" . "\t" . "Mobile no." . "\t". "Send Time" ."\t";

        $setData = '';  
        
        $rowData = ''; 

        $i=1;
        foreach ($otpData as $ldata) {  
            
            
            $pfnumber = $ldata->employee_code;
            $employee_name = $ldata->employee_name;
            $mobile = $ldata->mobile;
            $view_date = date('F,j Y - H:i A',strtotime($ldata->created));

            
            $ldata = '"' .$i. '"' . "\t";
            
            $ldata .= '"' . $pfnumber . '"' . "\t";

            $ldata .= '"' . $employee_name . '"' . "\t";

            $ldata .= '"' . $mobile . '"' . "\t";
            
            $ldata .= '"' . $view_date . '"' . "\t";  
            
            $rowData .= trim($ldata) . "\n";  
