	public function sr_update_page($year,$selected_department){
		$this->check_logg();
		$config = array();
		$data['Report'] = array();
		
		$year = $year;
			
		$startdate = $year.'-01-01 00:00:00';
		if($year!=date('Y')){
			$enddate = $year.'-12-31 00:00:00';
		}else{
			$enddate = date('Y-m-d H:i:s');
		}
		
		$selected_department = $selected_department;
		
		$department = $this->User_model->getdepartments();
		$config["base_url"] = base_url() . "user/sr_update_page/".$year."/".$selected_department;
		$data["total_rows"] = $config["total_rows"] = $this->User_model->getUpdateSrEmployeeOneYearCount($startdate, $enddate, $selected_department);
		$config["per_page"] = 10;
		$config["uri_segment"] = 5;
		$this->pagination->initialize($config);
		$data["page"] = $page = ($this->uri->segment(5)) ? $this->uri->segment(5) : 0;
		
		$data["links"] = $this->pagination->create_links();
		
		$report = $this->User_model->getUpdateSrEmployeeOneYear($startdate, $enddate, $selected_department, $config["per_page"], $page);
		
		$data['Year'] = $year;
		$data['tabname'] = 'sr';
