    public function generate_pdf($emp) {
        $emp = explode("_", $emp);
//        echo '<pre>';print_r($emp);exit;
        $this->load->library('Fpdf_gen');

        if ($emp[0] == 'LR') {
//        if ($emp[0] == 'MAP') {
            $pdf = new FPDF('L', 'mm', 'A3');
            $pdf->AddPage('L');
        } else {
            $pdf = new FPDF('P', 'mm');
            $pdf->AddPage('P');
        }

        $empcode =$emp[1];
        $empname = $this->File_model->getsinglefile($emp[1])->file_name;
        $grade_pay = $this->File_model->getsinglefile($emp[1])->file_year;
        $pay_scale = $this->File_model->getsinglefile($emp[1])->shelf_barcode;
        $pay_band = $this->File_model->getsinglefile($emp[1])->file_address;
        $title = $this->User_model->get_pdf_title($emp[0]);

        //$pdf->SetDisplayMode(real,'default');
        $pdf->SetFont('Arial', 'B', 18);
        if ($emp[0] == 'LR') {
//        if ($emp[0] == 'MAP') {
            $pdf->cell(400, 200, $title, 0, 0, 'C');
        } else {
            $pdf->cell(200, 200, $title, 0, 0, 'C');
        }
        if (!empty($emp[2])) {
            $pdf->Ln(8);
            $pdf->cell(200, 200, '(' . $emp[2] . ')', 0, 0, 'C');
        }
        $pdf->Ln(20);
        $pdf->SetFont('Arial', 'B', 14);

        if ($emp[0] == 'LR') {
//        if ($emp[0] == 'MAP') {
            $pdf->cell(400, 200, 'EMPLOYEE NAME : ' . $empname, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(400, 200, 'EMPLOYEE CODE : ' . $empcode, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(400, 200, 'EMPLOYEE GRADE PAY : ' . $grade_pay, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(400, 200, 'EMPLOYEE PAY SCALE : ' . $pay_scale, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(400, 200, 'EMPLOYEE PAY BAND : ' . $pay_band, 0, 0, 'C');
        } else {
            $pdf->cell(200, 200, 'FILE NAME : ' . $empname, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(200, 200, 'FILE BARCODE : ' . $empcode, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(200, 200, 'FILE YEAR : ' . $grade_pay, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(200, 200, 'SHELF BARCODE : ' . $pay_scale, 0, 0, 'C');
            $pdf->Ln(10);
            $pdf->cell(200, 200, 'ADDRESS : ' . $pay_band, 0, 0, 'C');
        }


        switch ($emp[0]) {
            case 'SB':
                $folder = 'service_book';
                $reports = $this->User_model->getallservicebook($emp[1]);
                break;
            case 'LR':
                $folder = 'leave_report';
                $reports = $this->User_model->getallleavereport($emp[1]);
                break;
            case 'APAR':
                $folder = 'APAR';
                $reports = $this->User_model->getApardetail($emp[1], $emp[2]);
                break;
            case 'SR':
                $folder = 'sr';
                $reports = $this->User_model->getSRdetail($emp[1]);
                break;
            case 'FILE':
                $folder = 'files';
                $reports = $this->User_model->getallFileCopy($emp[1]);
                break;
            case 'MAP':
                $folder = 'map';
                $reports = $this->User_model->getallmap($emp[1]);
                break;
        }

        if ($emp[0] == 'APAR') {
            foreach ($reports as $sb) {
                $pdf->AddPage();
                $image1 = base_url() . 'uploads/' . $empcode . '/' . $folder . '/' . $emp[2] . '/' . $sb->filename;
                $this->Header($pdf, $sb, $emp[0]);
//                if ($emp[0] == 'LR') {
                if ($emp[0] == 'MAP') {
                    $pdf->Image($image1, 10, 20, 400, 270);
                } else {
                    $pdf->Image($image1, 10, 20, 190, 270);
                }
            }
        } else if ($emp[0] == 'SR') {
            foreach ($reports as $sb) {
                $pdf->AddPage();
                $image1 = base_url() . 'uploads/' . $empcode . '/Attachment/' . $sb->filename;
                $this->Header($pdf, $sb, $emp[0]);
                if ($emp[0] == 'LR') {
//                if ($emp[0] == 'MAP') {
                    $pdf->Image($image1, 10, 20, 400, 270);
                } else {
                    $pdf->Image($image1, 10, 20, 190, 270);
                }
            }
        } else if ($emp[0] == 'MAP') {
            foreach ($reports as $sb) {
                $pdf->AddPage();
                $image1 = base_url() . 'uploads/' . $empcode . '/map/' . $sb->filename;
                $this->Header($pdf, $sb, $emp[0]);
                if ($emp[0] == 'LR') {
//                if ($emp[0] == 'MAP') {
                    $pdf->Image($image1, 10, 20, 400, 270);
                } else {
                    $pdf->Image($image1, 10, 20, 190, 270);
                }
            }
        } else {
            foreach ($reports as $sb) {

                $pdf->AddPage();
                $image1 = base_url() . 'uploads/' . $empcode . '/' . $folder . '/' . $sb->filename;
                $this->Header($pdf, $sb, $emp[0]);
                if ($emp[0] == 'LR') {
//                if ($emp[0] == 'MAP') {
                    $pdf->Image($image1, 10, 20, 400, 270);
                } else {
                    $pdf->Image($image1, 10, 20, 190, 270);
                }
            }
        }
		
        if($emp[0] == 'APAR'){
                $year = $emp[2];
                echo $pdf->Output($emp[0] . '-' . $empcode . '-' . $year . '.pdf', 'D');
        }else{
                echo $pdf->Output($emp[0] . '-' . $empcode . '.pdf', 'D');
        }
		
        
    }
    
    public function Header($pdf, $sb, $emp) {
        // Select Arial bold 15
        $pdf->SetFont('Arial', '', 10);
        $pdf->Cell(90, 0, 'Page : ' . $sb->pageno, 0, 0, 'L');
        if ($emp == 'LR') {
            $pdf->Cell(310, 0, 'Upload Time : ' . date('d M Y H:i:s', strtotime($sb->uploaded_at)), 0, 0, 'R');
        } else {
            $pdf->Cell(100, 0, 'Upload Time : ' . date('d M Y H:i:s', strtotime($sb->uploaded_at)), 0, 0, 'R');
        }
//        if ($emp == 'MAP') {
//            $pdf->Cell(310, 0, 'Upload Time : ' . date('d M Y H:i:s', strtotime($sb->uploaded_at)), 0, 0, 'R');
//        } else {
//            $pdf->Cell(100, 0, 'Upload Time : ' . date('d M Y H:i:s', strtotime($sb->uploaded_at)), 0, 0, 'R');
//        }
        
        // Line break
        //$pdf->Ln(10);
    }

    public function approve_reject() {
        $this->load->library('Class_activity');
        if ($this->input->post('submit') == 'Approve') {
            $status = 1;
        } else {
            $status = 0;
        }
        $data = array(
            'emp_id' => $this->input->post('emp_id'),
            'doc_type' => $this->input->post('doc_type'),
            'status' => $status,
            'remark' => $this->input->post('remark'),
            'verified_by' => $this->session->userdata('user_id')
        );

        if ($this->input->post('id') != '') {
            $result = $this->User_model->update_verification($data, $this->input->post('id'));
            $last_id = $this->input->post('id');
            $action = "UPDVER";
        } else {
            $result = $this->User_model->add_verification($data);
            $last_id = $this->db->insert_id();
            $action = "ADDVER";
        }

        if ($result > 0) {

            $ObjAction = new Class_activity();
            $ObjAction->activity_action = $action;
            $ObjAction->activity_user_id = $this->session->userdata('user_id');

            $ObjAction->login_id = $this->session->userdata('user_id');
            $ObjAction->verification_id = $last_id;
            $ObjAction->emp_id = $this->input->post('emp_id');
            $ObjAction->status = $status;
            $ObjAction->remark = $this->input->post('remark');
            $ObjAction->verified_by = $this->session->userdata('user_id');
            $activity_query = $ObjAction->LogDetails();

            $query = $this->db->query($activity_query);

            if ($status == 1) {
                $this->session->set_flashdata('item', array('message' => 'Documents approved successfully', 'class' => 'success'));
            } else {
                $this->session->set_flashdata('item', array('message' => 'Documents rejected successfully', 'class' => 'success'));
            }
        } else {
            $this->session->set_flashdata("error", "Failed to approve/reject documents.");
        }
        switch ($this->input->post('doc_type')) {
            case 'SB':
                redirect("user/viewservicebook/" . $this->input->post('emp_id'));
                break;
            case 'LR':
                redirect("user/viewleavereports/" . $this->input->post('emp_id'));
                break;
            case 'APAR':
                redirect("user/viewapar/" . $this->input->post('emp_id'));
                break;
            case 'SR':
                redirect("user/viewsr/" . $this->input->post('emp_id'));
                break;
            case 'MAP':
                redirect("user/viewmap/" . $this->input->post('emp_id'));
                break;
        }
    }

    public function view_records($type) {
		
		$this->check_logg();
		
        if ($type == 'sb') {
            $data['employee'] = $this->User_model->view_records('employee_service_book');
        }

        if ($type == 'lr') {
            $data['employee'] = $this->User_model->view_records('upload_emp_lr');
        }

        if ($type == 'sr') {
            $data['employee'] = $this->User_model->view_records('upload_sr');
        }

        if ($type == 'apar') {
            $data['employee'] = $this->User_model->view_records('upload_apar');
        }
        
        if ($type == 'map') {
            $data['employee'] = $this->User_model->view_records('upload_map');
        }
        if ($type == 'file') {
            $data['employee'] = $this->User_model->view_records('upload_file');
        }
        $this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("view_records", $data);
        $this->load->view("layout/footer");
    }

    public function bulk_upload() {
		
        $this->check_logg();
		
        $data['filecount'] = 0;
        $directory = "bulk/";
        if (glob($directory . "*") != false) {
            $data['filecount'] = count(glob($directory . "*"));
            //echo "Total number Of files in a folder:" .$filecount;
        }

        $this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("bulk_upload", $data);
        $this->load->view("layout/footer");
    }

    public function rename_files_folders() {
		
        $path = "bulk/";
        $dir = new DirectoryIterator($path);
        $data['Report'] = array();
        $data['Report']['failed'] = array();
        $data['Report']['success'] = array();
        $data['Report']['exist'] = array();
        $data['Report']['nofolder'] = array();
        $i = 0;
        $j = 0;
		
        $compress = $this->input->post('compress');
//        echo '<pre>';
//        print_r($dir);
//        exit;
        foreach ($dir as $fileinfo) {
            if ($fileinfo->isDir() && !$fileinfo->isDot()) {
                $empcode = $fileinfo->getFilename();
				
                if ($this->User_model->get_count_by_empcode($empcode) == 1) {
                    $filename = 'uploads/' . $empcode;

                    $empid = $this->User_model->Get_employee_code($empcode);
                    $subpath = $path . $empcode . '/';
                    if (file_exists($subpath . 'SR') || file_exists($subpath . 'sr') || file_exists($subpath . 'LR') || file_exists($subpath . 'lr') || file_exists($subpath . 'Attachment') || file_exists($subpath . 'APAR')) {
                        
						$errors = $this->renaming_process($empcode, $empid, $compress, $subpath);
                        
						$data['Report']['success'] += $errors;						
                        $i++;
                    } else {
                        $data['Report']['nofolder'][] = $empcode;
                        $j++;
                    }
                
                $srcount = $this->User_model->getEmployeeSRcountExcel($empid);
                $lrcount = $this->User_model->getEmployeeLRcountExcel($empid);
                $attachmentcount = $this->User_model->getEmployeeAttachmentcountExcel($empid);
                $aparcount = $this->User_model->getEmployeeAparcountexcel($empid);

                $this->User_model->incrementDecrementCounter('sr',$empid,$srcount);
                $this->User_model->incrementDecrementCounter('lr', $empid, $lrcount);
                $this->User_model->incrementDecrementCounter('attachment', $empid, $attachmentcount);

//                 print_r($aparcount);exit;
                $acount = '';
                if(!empty($aparcount)){
                    foreach($aparcount as $countapar){
                        $acount.= $countapar->startdate.'->'.$countapar->totalcount.' ';
                    }
                }else{
                    $acount = '0';
                }
                
                /*Preeti- 27-02-2020 - check Employee code exist in employee_document */
                $apar_count = 0;
		$emp = $this->User_model->checkEmp($empid);
                $amt = $this->User_model->getEmployeeAPARCount_nw($empid);
//                echo '<pre>'; print_r($amt->total);exit;
//                if($amt->total != 0){
//                    $apar_count = $amt->total;
//                }else{
//                    $apar_count = '0';
//                }
//echo '<pre>'; print_r($emp);exit;
		if($emp == 0){
                    $emp_details = $this->User_model->getEmployeeDetails($empcode);
                    $department = $this->User_model->getDepartmentNamebyID($emp_details->emp_department);
                    $designation = $this->User_model->getDesignationNamebyID($emp_details->emp_designation);

                        $employee_document_data = array(
                            "employee_id" => $emp_details->emp_id,
                            "employee_code" => $emp_details->employee_code,
                            "emp_name" => $emp_details->employee_name,
                            "department" => $department[0]->name,
                            "designation" => $designation[0]->name,
                            "sr" => '0',
                            "lr" => '0',
                            "apar" => $amt->total,
                            "attachment" => '0'
                        );
                        $this->User_model->add_employee_document($employee_document_data);
                    }else{
                        $this->User_model->aparUpdateCounter($amt->total,$empid);                        
                    }
                } else {
                    $data['Report']['failed'][] = $empcode;
                    $j++;
                }
            }
        }

        $data['Report']['fail_count'] = $j;
        $data['Report']['success_count'] = $i;
        
        $this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("bulk_upload", $data);
        $this->load->view("layout/footer");
    }
	
    public function renaming_process($empcode, $empid, $compress, $subpath) {

        $subdir = new DirectoryIterator($subpath);
        $ab = array($empcode => []);
        foreach ($subdir as $subfileinfo) {
			//echo $subfileinfo->getFilename();exit;
            if ($subfileinfo->isDir() && !$subfileinfo->isDot()) {
                switch ($subfileinfo->getFilename()) {
                    case 'SR' :
                    case 'sr' :
                        rename($subpath . $subfileinfo->getFilename(), $subpath . 'service_book/');
                        $files = array_diff(scandir($subpath . 'service_book/'), array('.', '..'));
                        foreach ($files as $file) {
                            if ($file != 'Thumbs.db') {
								
                                    if(!file_exists("uploads/" . $empcode)){
                                            @mkdir("uploads/" . $empcode, 0755);
                                    }

                                    if(!file_exists("uploads/" . $empcode . "/service_book")){
                                            @mkdir("uploads/" . $empcode . "/service_book", 0755);
                                    }						
								
                                $path_parts = pathinfo($subpath . 'service_book/' . $file);
                                $ext = $path_parts['extension'];
                                $page = $path_parts['filename'];
                                if (is_numeric($page)) {
                                    $new_filename = $empcode . '-SR-' . $page . '.' . $ext;
                                    $version = 1;

                                    if (file_exists("uploads/" . $empcode . "/service_book/" . $new_filename)) {
                                        $version = $this->User_model->getPagerVersionServiceBook($empid, $page);
                                        $new_filename = $empcode . "-SR-" . $page . "-V" . $version . "." . $ext;
                                    }

                                    $result = $this->User_model->saveservicebook($empid, $new_filename, $page, $version);
                                    if ($result == 1) {
                                        $insert_id = $this->db->insert_id();
                                        $this->User_model->mark_upload_as_bulk('employee_service_book', $insert_id);
                                    }
                                    rename($subpath . 'service_book/' . $file, $subpath . 'service_book/' . $new_filename);
									
                                    if($compress=='TRUE'){									
                                            $compress_image_path = $subpath . 'service_book/';
                                            $filesize = filesize($compress_image_path.$new_filename);
                                            if($filesize <= 512000){
                                                echo '';
                                            }elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
                                                $this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 60);
                                            }elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
                                                $this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 50);
                                            }elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
                                                $this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 35);
                                            }elseif($filesize > 4194304){ //4MB above 25%
                                                $this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 25);
                                            }else{
                                                echo '';
                                            }
                                    }									

                                    rename($subpath . 'service_book/' . $new_filename, 'uploads/'. $empcode . '/service_book/' . $new_filename);
                                } else {
                                    $ab[$empcode][] = $subpath . 'service_book/' . $file;
                                }
                            }
                        }
						
                        $filesdelete = array_diff(scandir($subpath . 'service_book/'), array('.', '..'));
                        if(empty($filesdelete)){
                                rmdir($subpath . 'service_book');							
                        }

                        $rootfolder = array_diff(scandir($subpath), array('.', '..'));
                        if(empty($rootfolder)){
                                rmdir("bulk/" .$empcode);
                        }						
                        break;

                    case 'LR' :
                    case 'lr' :
                        rename($subpath . $subfileinfo->getFilename(), $subpath . 'leave_report');
                        $files = array_diff(scandir($subpath . 'leave_report/'), array('.', '..'));
                        foreach ($files as $file) {
                            if ($file != 'Thumbs.db') {
								
								if(!file_exists("uploads/" . $empcode)){
									@mkdir("uploads/" . $empcode, 0755);
								}
								
								if(!file_exists("uploads/" . $empcode . "/leave_report")){
									@mkdir("uploads/" . $empcode . "/leave_report", 0755);
								}
								
                                $path_parts = pathinfo($subpath . 'leave_report/' . $file);
                                $ext = $path_parts['extension'];
                                $page = $path_parts['filename'];
                                if (is_numeric($page)) {
                                    $new_filename = $empcode . '-LR-' . $page . '.' . $ext;
                                    $version = 1;

                                    if (file_exists("uploads/" . $empcode . "/leave_report/" . $new_filename)) {
                                        $version = $this->User_model->getPagerVersionleavereport($empid, $page);
                                        $new_filename = $empcode . "-LR-" . $page . "-V" . $version . "." . $ext;
                                    }
                                    $result = $this->User_model->saveemplr($empid, $new_filename, $page, $version);
                                    if ($result == 1) {
                                        $insert_id = $this->db->insert_id();
                                        $this->User_model->mark_upload_as_bulk('upload_emp_lr', $insert_id);
                                    }
                                    rename($subpath . 'leave_report/' . $file, $subpath . 'leave_report/' . $new_filename);
									
									if($compress=='TRUE'){									
										$compress_image_path = $subpath . 'leave_report/';
										$filesize = filesize($compress_image_path.$new_filename);
										if($filesize <= 512000){
											echo '';
										}elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 60);
										}elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 50);
										}elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 35);
										}elseif($filesize > 4194304){ //4MB above 25%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 25);
										}else{
											echo '';
										}									
									}
									rename($subpath . 'leave_report/' . $new_filename, 'uploads/'. $empcode . '/leave_report/' . $new_filename);
									
                                } else {
                                    $ab[$empcode][] = $subpath . 'leave_report/' . $file;
                                }
                            }
                        }
						
						$filesdelete = array_diff(scandir($subpath . 'leave_report/'), array('.', '..'));
						if(empty($filesdelete)){
							rmdir($subpath . 'leave_report');							
						}
						
						$rootfolder = array_diff(scandir($subpath), array('.', '..'));
						if(empty($rootfolder)){
							rmdir("bulk/" .$empcode);
						}
                        break;

                    case 'APAR' :
                    case 'apar' :
                        $files = array_diff(scandir($subpath . 'APAR/'), array('.', '..'));
						
						//echo '<pre>';print_r($files);exit;
						
                            foreach ($files as $file) {
								//$ext = explode('.',$file);
								//$filec = $ext[0];
                            if ($file != 'Thumbs.db' && is_numeric($file)) { 
                                if(!file_exists("uploads/" . $empcode)){
									@mkdir("uploads/" . $empcode, 0755);
								}
								if(!file_exists("uploads/" . $empcode . "/APAR")){
									@mkdir("uploads/" . $empcode . "/APAR", 0755);
								}
								if(!file_exists("uploads/" . $empcode . "/APAR/" . $file)){
									@mkdir("uploads/" . $empcode . "/APAR/" . $file, 0755);
								}
								$subDir = array_diff(scandir($subpath . 'APAR/' . $file . '/'), array('.', '..'));
								
								foreach ($subDir as $newFile) {
									$ext = explode('.', $newFile);
									$nfcheck = $ext[0];
                                    if ($newFile != 'Thumbs.db' && is_numeric($nfcheck)) {
                                        $path_parts = pathinfo($subpath . 'APAR/' . $file . '/' . $newFile);
                                        $ext = $path_parts['extension'];
                                        $page = $path_parts['filename'];
                                        if (is_numeric($page)) { 
											
                                            $new_filename = $empcode . '-APAR-' . $page . '.' . $ext;
                                            $version = 1;

                                            if (file_exists("uploads/" . $empcode . "/APAR/" . $file . '/' . $new_filename)) {
                                                $version = $this->User_model->getPagerVersionApar($empid, $page);
                                                $new_filename = $empcode . "-APAR-" . $page . "-V" . $version . "." . $ext;
                                            }

                                            $result = $this->User_model->saveApar($empid, $new_filename, $page, $version, $file);
                                            if ($result == 1) {
                                                $insert_id = $this->db->insert_id();
                                                $this->User_model->mark_upload_as_bulk('upload_apar', $insert_id);
                                            }
																						
                                            rename($subpath . 'APAR/' . $file . '/' . $newFile, $subpath . 'APAR/' . $file . '/' . $new_filename);
											
											if($compress=='TRUE'){
												$compress_image_path = $subpath . 'APAR/' . $file . '/';
												$filesize = filesize($compress_image_path.$new_filename);
												if($filesize <= 512000){
													echo '';
												}elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
													$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 60);
												}elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
													$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 50);
												}elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
													$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 35);
												}elseif($filesize > 4194304){ //4MB above 25%
													$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 25);
												}else{
													echo '';
												}											
											}
											
											rename($subpath . 'APAR/' . $file . '/' . $new_filename, 'uploads/'. $empcode . '/APAR/' . $file . '/' . $new_filename);
											
                                        } else {
											
											
											
                                            $ab[$empcode][] = $subpath . 'APAR/' . $file . '/' . $newFile;
                                        }
                                    }else{
										$ab[$empcode][] = $subpath . 'APAR/' . $file .'/'. $newFile;
									}
                                }
								$subDirnew = array_diff(scandir($subpath. 'APAR/' . $file . '/'), array('.', '..'));
								if(empty($subDirnew)){rmdir($subpath. 'APAR/' . $file);}
								
                             }else{
								$ab[$empcode][] = $subpath . 'APAR/' . $file;
							}
                        }
						
						$filesdelete = array_diff(scandir($subpath . 'APAR/'), array('.', '..'));
						if(empty($filesdelete)){
							rmdir($subpath . 'APAR');							
						}
						
						$rootfolder = array_diff(scandir($subpath), array('.', '..'));
						if(empty($rootfolder)){
							rmdir("bulk/" .$empcode);
						}
                        break;

                    case 'Attachment' :
                    case 'attachment' :
                        rename($subpath . $subfileinfo->getFilename(), $subpath . 'Attachment/');
                        $del_val = array('Thumbs.db');
                        $files = array_diff(scandir($subpath . 'Attachment/'), array('.', '..'));
                        foreach ($files as $file) {
                            if ($file != 'Thumbs.db') {
                                $path_parts = pathinfo($subpath . 'Attachment/' . $file);
                                $ext = $path_parts['extension'];
                                $page = $path_parts['filename'];
                                if (is_numeric($page)) {
                                    $new_filename = $empcode . '-Attachment-' . $page . '.' . $ext;
                                    $version = 1;

                                    if (file_exists("uploads/" . $empcode . "/Attachment/" . $new_filename)) {
                                        $version = $this->User_model->getPagerVersionAttachment($empid, $page);
                                        $new_filename = $empcode . "-Attachment-" . $page . "-V" . $version . "." . $ext;
                                    }

                                    $result = $this->User_model->saveAttachment($empid, $new_filename, $page, $version);
                                    if ($result == 1) {
                                        $insert_id = $this->db->insert_id();
                                        $this->User_model->mark_upload_as_bulk('upload_attachment', $insert_id);
                                    }
                                    rename($subpath . 'Attachment/' . $file, $subpath . 'Attachment/' . $new_filename);
									
									if($compress=='TRUE'){
										$compress_image_path = $subpath . 'Attachment/';
										$filesize = filesize($compress_image_path.$new_filename);
										if($filesize <= 512000){
											echo '';
										}elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 60);
										}elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 50);
										}elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 35);
										}elseif($filesize > 4194304){ //4MB above 25%
											$this->User_model->compress($compress_image_path.$new_filename, $compress_image_path.$new_filename, 25);
										}else{
											echo '';
										}											
									}
									
									rename($subpath . 'Attachment/' . $new_filename, 'uploads/'. $empcode . '/Attachment/' . $new_filename);
                                } else {
                                    $ab[$empcode][] = $subpath . 'Attachment/' . $file;
                                }
                            }
                        }
						
						$filesdelete = array_diff(scandir($subpath . 'Attachment/'), array('.', '..'));
						if(empty($filesdelete)){
							rmdir($subpath . 'Attachment');							
						}
						
						$rootfolder = array_diff(scandir($subpath), array('.', '..'));
						if(empty($rootfolder)){
							rmdir("bulk/" .$empcode);
						}
						
                        break;
                }
            }
        }
        return $ab;
    }

	public function login_report(){
		
		$this->check_logg();
		
		$data['Report'] = array();
		$department = $this->User_model->getdepartments();		

        
        $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
		
        $data["links"] = $this->pagination->create_links();		
		
		$config["base_url"] = base_url() . "user/login_report";
        $config["total_rows"] = $this->User_model->getLoginHistoryCount($startdate='', $enddate='', $seldepartment='all');
        $config["per_page"] = 10;
        $config["uri_segment"] = 3;
		$this->pagination->initialize($config);
		
		$data['Report'] = $this->User_model->getLoginHistory($startdate='', $enddate='', $seldepartment='all', $config["per_page"], $page);
		$data['selecteddep'] = '';
		$data['departmentlist'] = $department;
		$this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("login_report", $data);
        $this->load->view("layout/footer");
	}
	
	public function login_report_filter($startdate='', $enddate='', $seldepartment=''){
		$this->check_logg();
		$data['Report'] = array();
		$department = $this->User_model->getdepartments();
		
		if(!empty($this->input->post()) && $this->input->post('search')=='Search'){
			
			$startdate = $this->input->post('startdate');
			$enddate = $this->input->post('enddate');
			$seldepartment = $this->input->post('department');
			
			$data["links"] = $this->pagination->create_links();		
		
			$config["base_url"] = base_url() . "user/login_report_filter".'/'.$startdate.'/'.$enddate.'/'.$seldepartment;
			$config["total_rows"] = $this->User_model->getLoginHistoryCount($startdate, $enddate, $seldepartment);
			$config["per_page"] = 10;
			$config["uri_segment"] = 6;
			$this->pagination->initialize($config);
			$page = ($this->uri->segment(6)) ? $this->uri->segment(6) : 0;
			$data['startdate'] = $startdate;
			$data['enddate'] = $enddate;
			$data['selecteddepsearch'] = $seldepartment;
			
			$data['Report'] = $this->User_model->getLoginHistory($startdate, $enddate, $seldepartment, $config["per_page"], $page);
			
		}
		
		$data['selecteddep'] = $seldepartment;
		$data['departmentlist'] = $department;
		$this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("login_report_filter", $data);
        $this->load->view("layout/footer");
		
	}
