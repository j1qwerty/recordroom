    public function uploadservice() {
		$this->check_logg();
        if (!empty($_FILES['image'])) {
            $ext = pathinfo($_FILES['image']['name'], PATHINFO_EXTENSION);
            $image = time() . 'sb.' . $ext;
            move_uploaded_file($_FILES["image"]["tmp_name"], 'uploads/' . $image);
            echo "Image uploaded successfully as " . $image;
        } else {
            echo "Image Is Empty";
        }
    }

