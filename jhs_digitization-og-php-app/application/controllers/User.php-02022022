	public function document_report(){

        $this->check_logg();
        $config = array();
        $data['Report'] = array();
        $department = $this->User_model->getdepartments();
        $data['departmentlist'] = $department;
        $data['selecteddep'] = '';

        $config["base_url"] = base_url() . "user/document_report";
        $data["total_rows"] = $config["total_rows"] = $this->User_model->getAllEmployeeCount();
        $config["per_page"] = 10;
        $config["uri_segment"] = 3;

        $this->pagination->initialize($config);
        $data["page"] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
		
        $data["links"] = $this->pagination->create_links();
		
        $data['Report'] = $this->User_model->getAllEmployeeList($config["per_page"], $page);
        // summary starts
        $data['srSummary'] = $this->User_model->getSR_SummarybyDept('all');
        $data['lrSummary'] = $this->User_model->getLR_SummarybyDept('all');
        $data['attachmentSummary'] = $this->User_model->getAttach_SummarybyDept('all');
        $aparSummary = $this->User_model->getApar_SummarybyDept('all');


        // print_r('<pre>');
        $current_year = date("Y");
        $countAparFinal = [];
			for($c=$current_year;$c>$current_year-5;$c--){
        			// $countApar[$c] = 0;
        			$totalCountApar[$c] = 0;
        			$totalPagesApar[$c] = 0;
        	}

        if(!empty($aparSummary)) {
            foreach ($aparSummary as $key => $value) {
            	for($c=$current_year;$c>$current_year-5;$c--){
	        			$countApar[$c] = 0;
	        	}
	        	if(!empty($value->apar)){
	        		$apar_year_wise = explode(' ', $value->apar);

	        			foreach ($apar_year_wise as $key => $value) {
	        				$explodedYearApar = explode('->', $value);
	        				// print_r('<pre>');
		        			// print_r($explodedYearApar);
		        			if(count($explodedYearApar) > 1){
			        			$countApar[$explodedYearApar[0]] = $explodedYearApar[1];
			        		}
	        			}

	        		// print_r($countApar);
	        		$countAparFinal[] = $countApar; 
	        		// exit;
	        	}
	        }
	    }
	    

//        print_r($countAparFinal);
        $total1 = $total2 = $total3 = $total4 = $total5 = $total6 = 0;

        $count1 = $count2 = $count3 = $count4 = $count5 = $count6 = 0;

        $totalApar = $countAparTotal = array(
        	$current_year => 0,
        	$current_year-1 => 0,
        	$current_year-2 => 0,
        	$current_year-3 => 0,
                $current_year-4 => 0,
//                $current_year-5 => 0
        );
        // print_r($countAparTotal);
        // exit;
        if(!empty($countAparFinal)){
        	$countAparTotal = array();
        	foreach ($countAparFinal as $key => $valueFinalArray) {
//                    echo '<pre>';print_r($valueFinalArray);exit;
        		foreach ($valueFinalArray as $key1 => $value) {
        			// if($value != 0 || $value != ''){
	        			if($key1 == $current_year){
	        				$value?$count1++:'';
	        				$total1 += $value;
	        				$totalApar[$current_year] = $total1;
	        				$countAparTotal[$current_year] = $count1;
	        			}elseif($key1 == $current_year-1){
	        				$value?$count2++:'';
	        				$total2 += $value;
	        				$totalApar[$current_year-1] = $total2;
	        				$countAparTotal[$current_year-1] = $count2;
	        			}elseif($key1 == $current_year-2){
	        				$value?$count3++:'';
	        				$total3 += $value;
	        				$totalApar[$current_year-2] = $total3;
	        				$countAparTotal[$current_year-2] = $count3;
	        			}elseif($key1 == $current_year-3){
	        				$value?$count4++:'';
	        				$total4 += $value;
	        				$totalApar[$current_year-3] = $total4;
	        				$countAparTotal[$current_year-3] = $count4;
	        			}elseif($key1 == $current_year-4){
	        				$value?$count5++:'';
	        				$total5 += $value;
	        				$totalApar[$current_year-4] = $total5;
	        				$countAparTotal[$current_year-4] = $count5;
//	        			}elseif($key1 == $current_year-5){
//	        				$value?$count6++:'';
//	        				$total6 += $value;
//	        				$totalApar[$current_year-5] = $total6;
//	        				$countAparTotal[$current_year-5] = $count6;
	        			}
	        		// }
        		}
        	}
        }
        
        $data['totalApar'] = $totalApar;
        $data['countAparTotal'] = $countAparTotal;
       
        // summary ends here

        // count of records
        $data['srCount'] = $this->User_model->getSR_CountbyDept('all');
        $data['lrCount'] = $this->User_model->getLR_CountbyDept('all');
        $data['attachCount'] = $this->User_model->getAt_CountbyDept('all');
        // count of records
        
        $this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("document_report", $data);
        $this->load->view("layout/footer");
	}
