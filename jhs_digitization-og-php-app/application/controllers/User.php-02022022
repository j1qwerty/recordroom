    public function getmobRegFile(){

        
        $columnHeader = '';
        
        $mobRegData = $this->User_model->mobRegData();      
        // print_r('<pre>');
        // print_r($mobRegData);
        // exit;
        $columnHeader = "Sr. No." . "\t" . "Department" . "\t" . "Employee Name / Designation" . "\t" . "Pf. No." . "\t";  
        $setData = '';  
        
        $rowData = ''; 
        $i=1;
        // print_r('<pre>');
        // print_r($mobRegData);
        // exit;
        foreach ($mobRegData as $ldata) {  
            $department = $this->User_model->getDepartmentNamebyID($ldata->emp_department);
            // print_r($department);
            // exit;
            $designation = $this->User_model->getDesignationNamebyID($ldata->emp_designation);
            // print_r($designation);
            // exit;
            $ldata = '"' .$i. '"' . "\t";
            
            $ldata .= '"' . @$department[0]->name . '"' . "\t";
            
            $designation_name = @$designation[0]->name;
            $ldata .= '"' . @$ldata->employee_name.'/'.@$designation[0]->name . '"' . "\t";
            
            $pf_number = @$ldata->employee_code;
            $ldata .= '"' . @$pf_number . '"' . "\t";
            
            $rowData .= trim($ldata) . "\n";  
            $i++;
        }  //exit;
        $setData .= trim($rowData) . "\n";        
          
        header("Content-type: application/octet-stream");  
        header("Content-Disposition: attachment; filename=auditReport.xls");  
        header("Pragma: no-cache");  
        header("Expires: 0");  
        
        echo ucwords($columnHeader) . "\n" . $setData . "\n";
    }
