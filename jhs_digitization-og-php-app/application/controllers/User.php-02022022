    public function otpsubmit() {
        if ($this->input->post("otp") == $this->session->userdata("otp")) {

            $query = $this->db->query("select employee_code,role from drm_employee where mobile='" . $this->session->userdata("mobile") . "'");
            $rs = $query->result();
            if ($rs[0]->role == 1) {
                $role = 'Supervisor';
            } elseif ($rs[0]->role == 2) {
                $role = 'Operator';
            } elseif ($rs[0]->role == 3) {
                $role = 'Employee';
            } else {
                $role = 'Admin';
            }
            $this->session->set_userdata("user_type", $role);
            $this->session->set_userdata("user_id", $rs[0]->employee_code);

            $this->session->set_userdata("otp", "");

            if ($role != 'Employee') {
                redirect("user/dashboard");
            } else {
                redirect("user/view_employee");
            }
        } else {
            $this->session->set_flashdata("error", "Invalid OTP entered!");
            redirect("user/enterotp");
        }
    }

    function clean($string) {
        $string = str_replace(' ', '-', $string); // Replaces all spaces with hyphens.

        return preg_replace('/[^A-Za-z0-9\-]/', '', $string); // Removes special chars.
    }

    public function recoverpassword() {

        $phonee = $this->input->post("mobile");

        $query = $this->db->query("select * from drm_employee where mobile='$phonee'");
        $rs = $query->result();

        if (count($rs) >= 1) {
            $password = rand();
            $user = "test_rail";

            $pass = "HTL@2020";

            $sender = "BHRAIL";


            if (strlen($phonee)) {

                $message = "Your onetime password is " . $password;
                $parameters = "user=$user&pass=$pass&sender=$sender&phone=$phonee&text=$message&priority=ndnd&stype=normal";

                $url = "http://msg.hashtaglabs.in/api/sendmsg.php?";

                $ch = curl_init($url);

                curl_setopt($ch, CURLOPT_POSTFIELDS, "user=$user&pass=$pass&sender=$sender&phone=$phonee&text=$message&priority=ndnd&stype=normal");


                curl_setopt($ch, CURLOPT_POST, 1);

                curl_setopt($ch, CURLOPT_POSTFIELDS, $parameters);

                curl_setopt($ch, CURLOPT_FOLLOWLOCATION, 1);

                curl_setopt($ch, CURLOPT_HEADER, 0);  // DO NOT RETURN HTTP HEADERS

                curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);  // RETURN THE CONTENTS OF THE CALL

                $return_val = curl_exec($ch);
                $this->session->set_userdata("otp", $password);
                $this->session->set_userdata("mobile", $phonee);
                redirect("user/enterotp");
            }
        } else {
            $this->session->set_flashdata("error", "Mobile no. does not exist!");
            redirect("user/forgotpassword");
        }
    }

    public function check_logg() {
        if ($this->session->userdata("user_type") != 'Admin' && $this->session->userdata("user_type") != 'Emp_view' && $this->session->userdata("user_type") != 'Emp_edit') {
            redirect("user");
        }
    }

    public function login_process() {
        $this->form_validation->set_rules('username', 'Username', 'required');
        $this->form_validation->set_rules('password', 'Password', 'required');

        if ($this->form_validation->run() == FALSE) {
            $this->load->view("login");
        } else {

            $user = $this->input->post("username");
            $pass = md5($this->input->post("password"));

            $num = $this->User_model->login_process_check($user, $pass);
            if (count($num) == 1) {
                $this->session->set_userdata("user_id", $num[0]->user_name);

                if ($num[0]->role == 1) {
                    $role = 'Emp_view';
                } elseif ($num[0]->role == 2) {
                    $role = 'Emp_edit';
                } else {
                    $role = 'Admin';
                }

                $userdata = array(
                    'user_id' => $num[0]->login_id,
                    'user_name' => $num[0]->user_name,
                    'role' => $role,
                    'web' => 1,
                    'mobile' => 0,
                    'ip' => $_SERVER['REMOTE_ADDR'],
                    'data' => $_SERVER['HTTP_USER_AGENT']
                );
                if ($num[0]->user_name == 'admin') {
                    $userdata['user_id'] = 0;
                } else {
                    $userdata['user_id'] = $num[0]->login_id;
                }
                $this->User_model->loginLogReport($userdata);
                $login_history_di = $this->db->insert_id();

                $this->session->set_userdata("loginidhistory", $login_history_di);

                $this->session->set_userdata("user_type", $role);
                
                redirect("user/dashboard");
                
//                echo '<pre>';print_r($_SESSION);exit;
//                if ($role != 'Employee') {
//                    redirect("user/dashboard");
//                } else {
//                    redirect("user/view_employee");
//                }
            } else {
                $this->session->set_flashdata("error", "You have entered incorrect username or password!");
                redirect("user");
            }
        }
    }

    public function dashboard() {

        $this->check_logg();
        
        $data['Report'] = array();
        
        $data['page'] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
        
        $config["base_url"] = base_url() . "user/dashboard";
        //$config["total_rows"] = $this->User_model->get_last_five_emps_count();
        $config["total_rows"] = $this->File_model->get_last_five_file_count();
