					// 	$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 60);
					// }elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
					// 	$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 50);
					// }elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
					// 	$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 35);
					// }elseif($filesize > 4194304){ //4MB above 25%
					// 	$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 25);
					// }else{
					// 	echo '';
					// }

                    $info = getimagesize($filesize);
                    if ($info['mime'] == 'image/jpeg') 
                        $image = imagecreatefromjpeg($filesize);
                    elseif ($info['mime'] == 'image/gif') 
                        $image = imagecreatefromgif($filesize);
                    elseif ($info['mime'] == 'image/png') 
                        $image = imagecreatefrompng($filesize);
					
                    move_uploaded_file($image, $filesize);

                    $pageno = $_POST['pageno'][$key2];
                    $vers = $this->User_model->getPagerVersionServiceBook($empid, $_POST['pageno'][$key2]);
                    $result = $this->User_model->saveservicebook($empid, $newfile_name, $pageno, $vers);
                }
                // $this->User_model->incrementCounter('sr',$empid);
            } else {
                array_push($error, "$file_name, ");
            }
        }
        $srcount = $this->User_model->getEmployeeSRcountExcel($empid);

        $this->User_model->incrementDecrementCounter('sr',$empid,$srcount);

        if ($result > 0) {
            $this->session->set_flashdata('item', array('message' => 'Service book added successfully', 'class' => 'success'));
            redirect("user/uploadservices/" . $empid);
        } else {
            $this->session->set_flashdata('item', array('message' => 'Service book update successfully', 'class' => 'success'));
            redirect("user/uploadservices/" . $empid);
        }
    }

    public function uploademplr() { 
		$this->check_logg();
		//LR Upload
        $empcode = $this->User_model->getsingleemployee($this->uri->segment(3))->employee_code;
        if (!file_exists("uploads/" . $empcode)) {
            mkdir("uploads/" . $empcode, 0755);
            mkdir("uploads/" . $empcode . "/service_book", 0755);
            mkdir("uploads/" . $empcode . "/leave_report", 0755);
            mkdir("uploads/" . $empcode . "/apar", 0755);
            mkdir("uploads/" . $empcode . "/sr", 0755);
        }
        $empid = $this->uri->segment(3);
        extract($_POST);
        $error = array();
        $extension = array("jpeg", "jpg", "png", "gif");

        foreach ($_POST['check'] as $key => $tmp_name) {
            $key2 = $_POST['check'][$key];
            $file_name = $_FILES["sbook"]["name"][$key2];
            $file_tmp = $_FILES["sbook"]["tmp_name"][$key2];
            $ext = pathinfo($file_name, PATHINFO_EXTENSION);
            $newfile_name = $empcode . "-LR-" . $_POST['pageno'][$key2] . "." . $ext;
            $image_name = time() . str_replace(" ", "", $newfile_name);
			
			$pagecounter = $this->User_model->checkDuplicateLRPageNo($_POST['pageno'][$key2], $empid);
			
            if (in_array($ext, $extension)) {
                if ($pagecounter == 0) {
					
					if (!file_exists("uploads/" . $empcode . "/leave_report")) {
						mkdir("uploads/" . $empcode . "/leave_report", 0755);
					}
					
                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $empcode . "/leave_report/" . $newfile_name);
					
					$pathimage = "uploads/" . $empcode . "/leave_report/"; 
					$filesize = $pathimage.$newfile_name;
										
					if($filesize <= 512000){
						echo '';
					}elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 60);
					}elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 50);
					}elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 35);
					}elseif($filesize > 4194304){ //4MB above 25%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 25);
					}else{
						echo '';
					}
					
                    $pageno = $_POST['pageno'][$key2];
                    $result = $this->User_model->saveemplr($empid, $newfile_name, $pageno, 1);
                } else {
                    $filename = basename($file_name, $ext);

                    $newfile_name = $empcode . "-LR-" . $_POST['pageno'][$key2] . "-V" . $this->User_model->getPagerVersionleavereport($empid, $_POST['pageno'][$key2]) . "." . $ext;
                    $image_name = time() . str_replace(" ", "", $newfile_name);

                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $empcode . "/leave_report/" . $newfile_name);
					
					$pathimage = "uploads/" . $empcode . "/leave_report/"; 
					$filesize = $pathimage.$newfile_name;
										
					if($filesize <= 512000){
						echo '';
					}elseif($filesize > 512000 && $filesize <= 819200){ //500KB to 800KB 60%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 60);
					}elseif($filesize > 819200 && $filesize <= 1536000){ //500KB to 1.5MB 50%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 50);
					}elseif($filesize > 1536000 && $filesize <= 4194304){ //1.5MB to 4MB 35%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 35);
					}elseif($filesize > 4194304){ //4MB above 25%
						$this->User_model->compress($pathimage.$newfile_name, $pathimage.$newfile_name, 25);
					}else{
						echo '';
					}
					
                    $pageno = $_POST['pageno'][$key2];
					$vers = $this->User_model->getPagerVersionleavereport($empid, $_POST['pageno'][$key2]);
                    $result = $this->User_model->saveemplr($empid, $newfile_name, $pageno, $vers);
                }
                // $this->User_model->incrementCounter('lr',$empid);
            } else {
                array_push($error, "$file_name, ");
            }
        }

        $lrcount = $this->User_model->getEmployeeLRcountExcel($empid);

        $this->User_model->incrementDecrementCounter('lr', $empid, $lrcount);

        if ($result > 0) {
            $this->session->set_flashdata('item', array('message' => 'Leave report added successfully', 'class' => 'success'));
            redirect("user/upload_emp_lr/" . $empid);
        } else {
            $this->session->set_flashdata('item', array('message' => 'Leave report update successfully', 'class' => 'success'));
            redirect("user/upload_emp_lr/" . $empid);
        }
    }

