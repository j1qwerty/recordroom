    public function uploadapart_report() {
		// print_r($_POST);
		$this->check_logg();
		
        $empcode = $this->User_model->getsingleemployee($this->uri->segment(3))->employee_code;
		echo $empcode;exit;
        if (!file_exists("uploads/" . $empcode)) {
            mkdir("uploads/" . $empcode, 0755);
            mkdir("uploads/" . $empcode . "/service_book", 0755);
            mkdir("uploads/" . $empcode . "/leave_report", 0755);
            mkdir("uploads/" . $empcode . "/APAR", 0755);
            mkdir("uploads/" . $empcode . "/Attachment", 0755);
        }
        $empid = $this->uri->segment(3);
        extract($_POST);
        $error = array();
        $extension = array("jpeg", "jpg", "png", "gif");
        foreach ($_POST['check'] as $key => $tmp_name) {
            $key2 = $_POST['check'][$key];
            $from = $_POST['years'];
            mkdir("uploads/" . $empcode . "/APAR/" . $from, 0755);
            $file_name = $_FILES["sbook"]["name"][$key2];
            $file_tmp = $_FILES["sbook"]["tmp_name"][$key2];
            $ext = pathinfo($file_name, PATHINFO_EXTENSION);
            $newfile_name = $empcode . "-APAR-" . $from . "-" . $_POST['pageno'][$key2] . "." . $ext;
			
			$pagecounter = $this->User_model->checkDuplicateAPARPageNo($_POST['pageno'][$key2], $empid); 
			
            $image_name = time() . str_replace(" ", "", $newfile_name);
            if (in_array($ext, $extension)) {
                if ($pagecounter==0) {
					
					if (!file_exists("uploads/" . $empcode . "/APAR")) {
						mkdir("uploads/" . $empcode . "/APAR", 0755);
					}
					
					if (!file_exists("uploads/" . $empcode . "/APAR/".$from)) {
						mkdir("uploads/" . $empcode . "/APAR/" . $from, 0755);
					}
					
                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $empcode . "/APAR/" . $from . '/' . $newfile_name);
                    $pageno = $_POST['pageno'][$key2];
                    $result = $this->User_model->saveaparreport($empid, $newfile_name, $pageno, $from, 1);
                } else {
                    $filename = basename($file_name, $ext);
                    $newfile_name = $empcode . "-AR-" . $from . "-" . $_POST['pageno'][$key2] . "-V" . $this->User_model->getPagerVersionapar($empid, $_POST['pageno'][$key2], $from) . "." . $ext;
                    move_uploaded_file($file_tmp = $_FILES["sbook"]["tmp_name"][$key2], "uploads/" . $empcode . "/apar/" . $from . '/' . $newfile_name);
                    $pageno = $_POST['pageno'][$key2];
					$vers = $this->User_model->getPagerVersionapar($empid, $_POST['pageno'][$key2], $from);
                    $result = $this->User_model->saveaparreport($empid, $newfile_name, $pageno, $from, $vers);
                }
            } else {
                array_push($error, "$file_name, ");
            }
        }

        $aparcount = $this->User_model->getEmployeeAparcountexcel($empid);
        // print_r($aparcount);
        $acount = '';
        if(!empty($aparcount)){
            foreach($aparcount as $countapar){
                $acount.= $countapar->startdate.'->'.$countapar->totalcount.' ';
            }
        }else{
            $acount = '0';
        }
		
			$this->User_model->aparUpdateCounter($acount,$empid);

        if ($result > 0) {

            $this->session->set_flashdata('item', array('message' => 'Apar report added successfully', 'class' => 'success'));
            redirect("user/upload_apar/" . $empid);
        } else {
            $this->session->set_flashdata('item', array('message' => 'Apar report update successfully', 'class' => 'success'));
            redirect("user/upload_apar/" . $empid);
        }
    }

