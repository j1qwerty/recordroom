	public function no_update_report(){
		$this->check_logg();
		$config = array();
		$data['Report'] = array();
		$department = $this->User_model->getdepartments();
		if(!empty($this->input->post()) && $this->input->post('searchsr')=='Search' && $this->input->post('datatype')=='sr'){
			
			$year = $this->input->post('sryear');
			
			$startdate = $year.'-01-01 00:00:00';
			if($year!=date('Y')){
				$enddate = $year.'-12-31 00:00:00';
			}else{
				$enddate = date('Y-m-d H:i:s');
			}
			
			$selected_department = $this->input->post('department');			
			
			$config["base_url"] = base_url() . "user/no_sr_update_page/".$year.'/'.$selected_department;
			$data["total_rows"] = $config["total_rows"] = $this->User_model->getNotUpdateSrEmployeeOneYearCount($startdate, $enddate, $selected_department);
			$config["per_page"] = 10;
			$config["uri_segment"] = 3;
			$this->pagination->initialize($config);
			$data["page"] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
			
			$data["links"] = $this->pagination->create_links();
			
			$report = $this->User_model->getNotUpdateSrEmployeeOneYear($startdate, $enddate, $selected_department, $config["per_page"], $page);
			// print_r('<pre>');
			// print_r($report);
			// die;
			$data['Year'] = $year;
			$data['tabname'] = 'sr';
			$data['selecteddep'] = $selected_department;
			if(!empty($report)){
				$data['ReportSr'] = $report;
			}else{
				$data['ReportSr'] = 'No Data';
			}
			
		}else if(!empty($this->input->post()) && $this->input->post('searchlr')=='Search' && $this->input->post('datatype')=='lr'){
			
			//$year = $this->input->post('lryear');
			
			$startdate = $this->input->post('startdate');
			$enddate = $this->input->post('enddate');
			$selected_department = $this->input->post('department');
			
			$config["base_url"] = base_url() . "user/no_lr_update_page/".$startdate.'/'.$enddate.'/'.$selected_department;
			$data["total_rows"] = $config["total_rows"] = $this->User_model->getNotUpdateLrEmployeeOneYearCount($startdate, $enddate, $selected_department);
			$config["per_page"] = 10;
			$config["uri_segment"] = 3;

			$this->pagination->initialize($config);
			$data["page"] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
			
			$data["links"] = $this->pagination->create_links();
			
			$report = $this->User_model->getNotUpdateLrEmployeeOneYear($startdate, $enddate, $selected_department, $config["per_page"], $page);
			
			//$data['Year'] = $year;
			$data['tabname'] = 'lr';
			$data['selecteddep'] = $selected_department;
			if(!empty($report)){
				$data['ReportLr'] = $report;
			}else{
				$data['ReportLr'] = 'No Data';
			}
			
		}else if(!empty($this->input->post()) && $this->input->post('searchapar')=='Search' && $this->input->post('datatype')=='apar'){
			
			$year = $this->input->post('aparyear');
			$selected_department = $this->input->post('department');
			
			$startdate = $year.'-01-01 00:00:00';
			if($year!=date('Y')){
				$enddate = $year.'-12-31 00:00:00';
			}else{
				$enddate = date('Y-m-d H:i:s');
			}			
			
			$config["base_url"] = base_url() . "user/no_apar_update_page/".$year.'/'.$selected_department;
			$data["total_rows"] = $config["total_rows"] = $this->User_model->getNotUpdateAparEmployeeOneYearCount($startdate, $enddate, $selected_department);
			$config["per_page"] = 10;
			$config["uri_segment"] = 3;

			$this->pagination->initialize($config);
			$data["page"] = $page = ($this->uri->segment(3)) ? $this->uri->segment(3) : 0;
			
			$data["links"] = $this->pagination->create_links();
			
			$report = $this->User_model->getNotUpdateAparEmployeeOneYear($startdate, $enddate, $selected_department, $config["per_page"], $page);
			
			$data['Year'] = $year;
			$data['selecteddep'] = $selected_department;
			$data['tabname'] = 'apar';
			if(!empty($report)){
				$data['ReportApar'] = $report;
			}else{
				$data['ReportApar'] = 'No Data';
			}
			
		}else{
			$data['tabname'] = 'sr';
			$data['ReportApar'] = 'No Data';
			$data['selecteddep'] = '';
			$data['Year'] = '2019';
		}
		$data['departmentlist'] = $department;
		$this->load->view("layout/header");
        $this->load->view("layout/leftmenu");
        $this->load->view("no_update_report", $data);
        $this->load->view("layout/footer");
	}
	
