{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.EntityFrameworkCore.Database.Command":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "ConnectionStrings":  {
                              "Default":  "Server=localhost;Database=RecordRoom;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
                          },
    "Jwt":  {
                "Issuer":  "record-room-api",
                "Audience":  "record-room-frontend",
                "SigningKey":  "dev-only-signing-key-change-me-in-production-000000",
                "ExpiryMinutes":  120
            },
    "Database":  {
                     "MigrateOnStartup":  true,
                     "SeedOnStartup":  true
                 },
    "Redis":  {
                  "ConnectionString":  ""
              },
    "Hangfire":  {
                     "Storage":  "InMemory"
                 },
    "Swagger":  {
                    "Enabled":  true
                },
    "Cors":  {
                 "AllowedOrigins":  [
                                        "http://localhost:5173"
                                    ]
             }
}
